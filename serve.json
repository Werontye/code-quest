{
  "public": ".",
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/index", "destination": "/index.html" },
    { "source": "/pages/profile", "destination": "/pages/profile.html" },
    { "source": "/pages/game", "destination": "/pages/game.html" },
    { "source": "/pages/levels", "destination": "/pages/levels.html" },
    { "source": "/pages/theory", "destination": "/pages/theory.html" }
  ],
  "headers": [
    {
      "source": "**/*.@(js|css|html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "cleanUrls": false,
  "directoryListing": false,
  "trailingSlash": false
}
